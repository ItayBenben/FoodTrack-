{
  "name": "@foodtrack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src test",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:rollback": "tsx src/cli/migrate.ts down",
    "db:seed": "tsx src/cli/seed.ts",
    "keys": "tsx src/cli/keys.ts",
    "reset-passphrase": "tsx src/cli/reset-passphrase.ts",
    "create-user": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@foodtrack/shared": "workspace:*",
    "@foodtrack/tracker-schema": "workspace:*",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
