# FoodTrack — copy to .env. Every variable is documented here (06 §5 "Secrets").
# Generate secrets with:  openssl rand -base64 32

# ── Database (docker compose creates both roles on first boot) ──
POSTGRES_SUPERUSER_PASSWORD=change-me
FOODTRACK_DB_OWNER_PASSWORD=change-me-owner      # owns the schema, runs migrations
FOODTRACK_DB_APP_PASSWORD=change-me-app          # what the API/worker/analysis connect as (RLS applies)
# Local dev without Docker uses these directly (scripts/dev-db.sh creates them):
DATABASE_URL=postgres://foodtrack_app:foodtrack_app@localhost:5432/foodtrack
DATABASE_OWNER_URL=postgres://foodtrack:foodtrack@localhost:5432/foodtrack

# ── Secrets ──
SESSION_SECRET=                                  # ≥ 32 chars; signs access tokens
FOODTRACK_KEK=                                   # written by `pnpm keys:init`. Losing it = losing encrypted fields; keep the recovery card off-box.

# ── Deployment ──
FOODTRACK_DOMAIN=localhost                       # Caddy obtains a certificate for this name
PUBLIC_ORIGIN=https://localhost                  # used for the CSRF origin check
AUTH_MODE=single                                 # single (one passphrase) | multi (email + password)

# ── Services ──
ANALYSIS_URL=http://localhost:8000
MEDIA_DIR=./data/media                           # encrypted photo objects

# ── LLM (optional — the deterministic provider always works with none of these set) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TEXT=<model-id>                  # model used for meal parsing and narratives
ANTHROPIC_MODEL_VISION=<model-id>                # only if you enable photo parsing in config/llm.json
OPENAI_COMPAT_URL=                               # e.g. http://ollama:11434/v1 for a local model
OPENAI_COMPAT_MODEL=
LLM_PROVIDER=auto                                # auto | anthropic | openai-compat | deterministic

# ── Food data enrichment (optional; never on the request path) ──
OFF_USER_AGENT=FoodTrack/1.0 (self-hosted)
FDC_API_KEY=

# ── Web push (optional; generate once with `pnpm --filter @foodtrack/api vapid`) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
