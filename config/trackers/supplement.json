            "he": "סיבים"
          }
        },
        {
          "value": "magnesium",
          "labels": {
            "en": "Magnesium",
            "he": "מגנזיום"
          }
        },
        {
          "value": "iron",
          "labels": {
            "en": "Iron",
            "he": "ברזל"
          }
        },
        {
          "value": "vitamin",
          "labels": {
            "en": "Vitamin",
            "he": "ויטמין"
          }
        },
        {
          "value": "other",
          "labels": {
            "en": "Other",
            "he": "אחר"
          }
        }
