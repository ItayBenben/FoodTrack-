            "he": "תוסף סיבים"
          }
        }
      },
      {
        "key": "magnesium",
        "op": "any",
        "field": "class",
        "in": [
          "magnesium"
        ],
        "analysis": {
          "role": "confounder",
          "type": "binary",
          "labels": {
            "en": "Magnesium",
            "he": "מגנזיום"
